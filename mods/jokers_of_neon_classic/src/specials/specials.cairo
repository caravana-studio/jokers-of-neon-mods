pub fn get_special_info(special_id: u32) -> (u32, u32, u32) {
    if contains(SPECIALS_C_IDS(), special_id) {
        (0, 1000, 45)
    } else if contains(SPECIALS_B_IDS(), special_id) {
        (1, 1750, 25)
    } else if contains(SPECIALS_A_IDS(), special_id) {
        (2, 3500, 15)
    } else if contains(SPECIALS_S_IDS(), special_id) {
        (3, 5000, 15)
    } else {
        panic!("[mods] - Cannot retrieve special info for id ({})", special_id);
    }
}

